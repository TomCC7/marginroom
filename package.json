{
  "name": "marginroom",
  "version": "0.1.0",
  "private": true,
  "description": "Imported HTML review with comments and paragraph suggestions",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/run.mjs",
    "test:unit": "node test/run.mjs unit",
    "test:api": "node test/run.mjs api",
    "test:browser": "node test/frontend.browser.mjs",
    "test:all": "npm test && npm run test:browser && npm run test:security && npm run test:acceptance",
    "browser:install": "playwright-core install chromium",
    "test:acceptance": "node test/release-acceptance.mjs",
    "test:security": "node test/security-release.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie": "^0.7.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "engines": {
    "node": ">=22.22.2 <23 || >=24.14.0"
  }
}
