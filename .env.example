# Optional Compose settings. No secrets need to be entered for a fresh Docker install:
# /data/identity.json is created once with random OWNER_KEY and SESSION_SECRET.
MMW_PORT=3939
# Loopback HTTP needs non-Secure cookies. For HTTPS reverse-proxy deployments:
# NODE_ENV=production
NODE_ENV=development
# Compose does not pass OWNER_KEY/SESSION_SECRET from this file to the app.
# Native Node installs must explicitly export both stable secrets; see README.
